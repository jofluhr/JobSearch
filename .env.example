# Copy to .env and fill in. .env is gitignored.

# Candidate profile (Markdown), read only. Needed from Phase 3 on.
PROFILE_PATH=C:\path\to\profile.md

# Home location used for radius queries and distances. Required, no defaults.
# HOME_LOCATION is the city name the Bundesagentur search understands,
# HOME_LAT/HOME_LON its coordinates in decimal degrees.
HOME_LOCATION=
HOME_LAT=
HOME_LON=
RADIUS_KM=30
RADIUS_TARGET_COMPANY_KM=70

# Remote postings: how many days back the nationwide query looks at most
REMOTE_MAX_WINDOW_DAYS=14

# A Job absent from every Source this long becomes a Reopening when it shows up again
REOPENING_DAYS=21

# Indeed alert mail (Phase 5)
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_PROCESSED_FOLDER=verarbeitet

# AI through claude -p on the subscription (Phase 3)
MODEL_SCORING=sonnet
MODEL_EXTRACTION=haiku
MAX_SCORED_PER_RUN=40
FEEDBACK_NOTES_IN_PROMPT=20

CAREER_SCAN_INTERVAL_DAYS=7
REPORT_INTERVAL_DAYS=7

# Optional tracing into a local Phoenix (pip install -e ".[trace]", Phoenix runs on its own).
# Empty: off. Only addresses on this machine are accepted, the traces hold the Profile and job ads.
# Phoenix default. Use 127.0.0.1, not localhost: Phoenix listens on IPv4 only, and on Windows
# every connection to localhost first waits about 2 seconds for IPv6.
# TRACING_ENDPOINT=http://127.0.0.1:6006/v1/traces
TRACING_ENDPOINT=
